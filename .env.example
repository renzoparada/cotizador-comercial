# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo para scripts server-side de administración (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sitio (usada para generar los enlaces de propuesta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA (opcional) — habilita los "Extras Inteligentes" con Claude
ANTHROPIC_API_KEY=

# Notificaciones (opcional) — webhook para avisar al admin cuando aceptan una propuesta
NOTIFY_WEBHOOK_URL=
