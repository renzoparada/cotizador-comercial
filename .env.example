# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo para scripts server-side de administración (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sitio (usada para generar los enlaces de propuesta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA (opcional) — habilita los "Extras Inteligentes" con Google Gemini
# Obtén tu key gratis (sin tarjeta) en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Notificaciones (opcional) — webhook para avisar al admin cuando aceptan una propuesta
NOTIFY_WEBHOOK_URL=
